# OpenADS on Cloudflare: copy to deploy/.env.cloudflare (ignored by git), fill
# it in, then run `npm run deploy:cloudflare`. Guide: docs/SELF_HOSTING_CLOUDFLARE.md
# No secrets are needed here: the deploy generates TOKEN_ENCRYPTION_KEY itself
# (back it up: see the guide), and Google Ads and Meta Ads are set up in the app
# (Sources → Set up Google Ads / Set up Meta Ads).
# Keep the filled-in file private: chmod 600 deploy/.env.cloudflare

# ---------- Required ----------

# Your Cloudflare account ID (32 hex characters; dashboard → Account home → ⋮ → Copy account ID).
CLOUDFLARE_ACCOUNT_ID=

# Host name people open, in a zone (domain) of that account; becomes https://<host>.
OPENADS_HOSTNAME=openads.example.com

# Zero Trust team domain, bare (Zero Trust → Settings → Custom Pages / team domain).
ACCESS_TEAM_HOSTNAME=your-team.cloudflareaccess.com

# Audience (AUD) tag of the Access application that covers OPENADS_HOSTNAME.
ACCESS_AUDIENCE=

# Who may sign in, mirroring the Access policy: exact addresses and/or whole @domains.
ACCESS_ALLOWED_EMAILS=you@example.com

# Instance admins (exact addresses): they set up Google Ads / Meta Ads and connect sources.
OPENADS_ADMIN_EMAILS=you@example.com

# ---------- Optional ----------

# Worker and D1 database names (default: openads).
# OPENADS_WORKER_NAME=openads
# OPENADS_D1_NAME=openads

# Google Ads API version; default is the version pinned by this release.
# GOOGLE_API_VERSION=

# Meta Ads: set up in the app by default. Optional deployment overrides — when
# both are set they take precedence and the wizard shows "managed by deployment":
# META_APP_ID=
# META_APP_SECRET is uploaded encrypted with each deploy (never printed); or set it
# once with `npx wrangler secret put META_APP_SECRET --name openads` and leave it out.
# META_APP_SECRET=

# Graph API version; default is the version pinned by this release (v27.0).
# META_API_VERSION=

# Exact Meta action type counted as conversions; otherwise chosen on the Sources
# page (default purchase). When set, the Sources page shows it read-only.
# META_CONVERSION_ACTION_TYPE=

# ---------- Restore only ----------

# Only when the Worker lost its key (deleted or recreated) but the D1 database still
# holds data encrypted with it: the old key from your backup. Uploaded only if the
# Worker has no key and it matches the stored data; never replaces a key. Remove it
# again after the deploy.
# TOKEN_ENCRYPTION_KEY=
