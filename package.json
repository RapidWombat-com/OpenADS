{
  "name": "openads",
  "version": "0.0.1",
  "description": "Open-source, self-hosted ad reporting for Google Ads and Meta Ads",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "vite build",
    "test": "tsc --noEmit && node --test tests/*.test.ts",
    "test:integration": "node --test tests/*.integration.mjs",
    "dry-run": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run",
    "preview:local": "vite build && node scripts/preview.mjs",
    "deploy:cloudflare": "node -- scripts/deploy-cloudflare.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "jose": "6.2.18",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.65.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "4.165.0"
  }
}
